{
  "name": "corex-market-data",
  "version": "2026.1.21",
  "description": "CoreX Market Data Layer — DataProviderContract, providers (TwelveData, Yahoo, File), DataProviderFactory, MarketFeed",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest --passWithNoTests --testTimeout=20000"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "winston": "^3.19.0",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "module-alias": "^2.2.3"
  },
  "_moduleAliases": {
    "@root": "../..",
    "@core": "../../engine",
    "@strategies": "../../strategies",
    "@utils": "../../utils",
    "@broker": "../../broker",
    "@data": "./src",
    "@events": "../../events",
    "@config": "../../config"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@root/(.*)$": "<rootDir>/../../$1",
      "^@core/(.*)$": "<rootDir>/../../engine/$1",
      "^@strategies/(.*)$": "<rootDir>/../../strategies/$1",
      "^@utils/(.*)$": "<rootDir>/../../utils/$1",
      "^@broker/(.*)$": "<rootDir>/../../broker/$1",
      "^@data/(.*)$": "<rootDir>/src/$1",
      "^@events/(.*)$": "<rootDir>/../../events/$1",
      "^@config/(.*)$": "<rootDir>/../../config/$1"
    }
  }
}
