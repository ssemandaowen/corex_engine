{
  "name": "corex-gateway",
  "version": "2026.1.22",
  "description": "CoreX Gateway Layer — Socket_X protocol, account model, connection lifecycle, auth/risk injection points",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest --passWithNoTests --testTimeout=20000"
  },
  "dependencies": {
    "ws": "^8.18.3",
    "winston": "^3.19.0",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "corex-broker-contract": "file:../corex-broker-contract"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "module-alias": "^2.2.3"
  },
  "_moduleAliases": {
    "@root": "../..",
    "@core": "../../engine",
    "@strategies": "../../strategies",
    "@utils": "../../utils",
    "@broker": "../corex-broker-contract/src",
    "@gateway": "./src",
    "@events": "../../events",
    "@config": "../../config"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@root/(.*)$": "<rootDir>/../../$1",
      "^@core/(.*)$": "<rootDir>/../../engine/$1",
      "^@strategies/(.*)$": "<rootDir>/../../strategies/$1",
      "^@utils/(.*)$": "<rootDir>/../../utils/$1",
      "^@broker/(.*)$": "<rootDir>/../corex-broker-contract/src/$1",
      "^@gateway/(.*)$": "<rootDir>/src/$1",
      "^@events/(.*)$": "<rootDir>/../../events/$1",
      "^@config/(.*)$": "<rootDir>/../../config/$1"
    }
  }
}
