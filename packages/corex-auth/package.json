{
  "name": "corex-auth",
  "version": "2026.1.21",
  "description": "CoreX Auth Layer — JWT signing/verification (AuthService), AES-256-GCM encryption (SecretsVault)",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest --passWithNoTests --testTimeout=20000"
  },
  "dependencies": {},
  "devDependencies": {
    "jest": "^29.7.0",
    "module-alias": "^2.2.3"
  },
  "_moduleAliases": {
    "@root": "../..",
    "@core": "../../engine",
    "@utils": "../../utils",
    "@events": "../../events",
    "@config": "../../config"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@root/(.*)$": "<rootDir>/../../$1",
      "^@core/(.*)$": "<rootDir>/../../engine/$1",
      "^@utils/(.*)$": "<rootDir>/../../utils/$1",
      "^@events/(.*)$": "<rootDir>/../../events/$1",
      "^@config/(.*)$": "<rootDir>/../../config/$1"
    }
  }
}