{
  "name": "corex-strategy-engine",
  "version": "2026.1.20",
  "description": "CoreX strategy runtime, lifecycle, parameters and incremental technical indicators",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "jest --passWithNoTests --testTimeout=20000",
    "test:ratchet": "jest --runInBand test/characterisation/ratchet.test.js",
    "test:golden:update": "node test/characterisation/update-golden.js",
    "test:memory": "node --expose-gc bench/memory-smoke.js",
    "bench": "node --expose-gc bench/bar-close-benchmark.js",
    "bench:tick": "node bench/tick-throughput.js"
  },
  "dependencies": {
    "mathjs": "^15.1.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "module-alias": "^2.2.3"
  },
  "_moduleAliases": {
    "@root": "../..",
    "@core": "../../engine",
    "@utils": "../../utils",
    "@config": "../../config",
    "@events": "../../events",
    "corex-broker-contract": "../../packages/corex-broker-contract",
    "corex-strategy-engine": "."
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@root/(.*)$": "<rootDir>/../../$1",
      "^@core/(.*)$": "<rootDir>/../../engine/$1",
      "^@utils/(.*)$": "<rootDir>/../../utils/$1",
      "^@config/(.*)$": "<rootDir>/../../config/$1",
      "^@events/(.*)$": "<rootDir>/../../events/$1",
      "^corex-broker-contract$": "<rootDir>/../../packages/corex-broker-contract/index.js",
      "^corex-strategy-engine$": "<rootDir>/index.js"
    }
  }
}
