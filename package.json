{
  "name": "corex-engine",
  "version": "2026.1.20",
  "description": "Proprietary High-Fidelity Trading Engine | Apex Trait Ltd",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --passWithNoTests",
    "test:auth": "jest --runInBand test/auth.service.test.js test/auth.integration.test.js",
    "ui:dev": "npm --prefix corex-ui run dev",
    "ui:build": "npm --prefix corex-ui run build",
    "ui:preview": "npm --prefix corex-ui run preview",
    "db:migrate": "node db/migrate.js",
    "strategies:migrate": "node db/migrate_strategies_to_db.js",
    "core:clean": "node -e \"const fs=require('fs'); fs.rmSync('./data/backtests/', {recursive:true, force:true})\"",
    "status": "node ./utils/system-check.js",
    "mt5:receiver": "python engine/managers/mt5Receiver.py",
    "mt5:receiver:env": "set DOTENV_CONFIG_PATH=.env.receiver && python engine/managers/mt5Receiver.py",
    "db:start": "pg_ctl start -D \"%USERPROFILE%/scoop/persist/postgresql/data\" -w",
    "db:stop": "pg_ctl stop -D \"%USERPROFILE%/scoop/persist/postgresql/data\" -m fast",
    "db:status": "pg_ctl status -D \"%USERPROFILE%/scoop/persist/postgresql/data\"",
    "bench:engine": "node scripts/bench/engine-micro-bench.js",
    "maintenance:prune": "node scripts/maintenance/prune-runtime-artifacts.js",
    "maintenance:prune:apply": "node scripts/maintenance/prune-runtime-artifacts.js --apply"
  },
  "_moduleAliases": {
    "@root": ".",
    "@core": "./engine",
    "@strategies": "./strategies",
    "@utils": "./utils",
    "@broker": "./broker",
    "@events": "./events",
    "@config": "./config"
  },
  "author": "Ssemanda Owen (Apex Trait Ltd)",
  "license": "UNLICENSED",
  "dependencies": {
    "@oanda/v20": "^3.0.25-0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "axios": "^1.13.2",
    "cors": "^2.8.6",
    "data-forge": "^1.10.4",
    "data-forge-fs": "^0.0.9",
    "dotenv": "^17.2.3",
    "eventemitter3": "^5.0.1",
    "express": "^5.2.1",
    "grademark": "^0.3.0",
    "mathjs": "^15.1.0",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "technicalindicators": "^3.1.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11"
  },
  "jest": {
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "moduleNameMapper": {
      "^@root/(.*)$": "<rootDir>/$1",
      "^@core/(.*)$": "<rootDir>/engine/$1",
      "^@strategies/(.*)$": "<rootDir>/strategies/$1",
      "^@utils/(.*)$": "<rootDir>/utils/$1",
      "^@broker/(.*)$": "<rootDir>/broker/$1",
      "^@events/(.*)$": "<rootDir>/events/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  }
}
